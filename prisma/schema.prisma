// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id              String   @id @default(cuid())
  imageUrl        String?  @map("image_url")
  imagePosition   String?  @default("50% 50%") @map("image_position")
  name            String
  category        String?
  modelOrSize     String   @map("model_or_size")
  quantity        Int
  unit            String
  categoryStatus  String   @map("category_status") // 'R', 'Y', 'G', or 'B'
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("assets")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  fullName  String?  @map("full_name")
  role      String   @default("USER") // 'ADMIN', 'OPERATOR', 'USER'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  logs      ActivityLog[]

  @@map("users")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g., 'CREATE_ASSET', 'UPDATE_ASSET', 'DELETE_ASSET', 'UPDATE_QUANTITY'
  details   String?  // JSON string or descriptive text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}
