# Copy to agent/.env on the Raspberry Pi and fill in. Never commit .env.

# The web app's public address (no trailing slash).
CLOUD_URL=https://wp.gmr.co.th

# Must equal MODBUS_AGENT_TOKEN on the web app. Make it long and random, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODBUS_AGENT_TOKEN=

# Module addresses are normally set on the web page (/modbus -> "ตั้งค่าโมดูล (IP)")
# and downloaded by the agent. The values below are only the FALLBACK used until
# the web app has sent them (or when none were saved there).
#
# Module 1 (CH1-CH16) on the office LAN.
MODBUS_HOST=192.168.1.12
MODBUS_PORT=502
MODBUS_UNIT_ID=1

# Module 2 (CH17-CH32). Leave empty until it is installed — the web page shows
# its zones as "not configured". Fill in its IP later and restart the agent.
# Port and unit ID default to module 1's.
MODBUS_HOST_2=
# MODBUS_PORT_2=502
# MODBUS_UNIT_ID_2=1

# Optional tuning
# AGENT_LONGPOLL_MS=20000 # the agent keeps a request open on the web app and is answered the
#                         # instant a button is pressed (button-to-light well under 1 s).
#                         # 0 = plain polling every AGENT_POLL_MS (use that if the web app is
#                         # on a host that can't hold requests open, e.g. serverless Vercel)
# AGENT_POLL_MS=1000      # plain-polling interval (only used when AGENT_LONGPOLL_MS=0)
# AGENT_FAST_POLL_MS=250  # plain polling only: how often to ask WHILE someone is using the /modbus page
#                         # (or just pressed a switch) — the page tells the web app, which tells the Pi.
#                         # The rest of the time it asks every AGENT_POLL_MS (3000-5000 is a good value on Vercel).
# AGENT_TICK_MS=400       # main loop: applies a change to the module and reports it back
#                         # (button-to-light delay ~ poll + 2 x tick; lower = snappier, more requests)
# AGENT_REPORT_MS=5000    # heartbeat: report the module state at least this often
# MODBUS_KEEPALIVE_MS=500 # Modbus poll interval while any output is ON (module watchdog is ~2 s)
