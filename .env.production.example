# Copy this file to .env.production on the SERVER and fill in real values.
# Never commit .env.production itself — it's gitignored (.env*).

# Same Neon / Prisma Postgres database the app already uses on Vercel — no
# data migration needed, just point at the same connection strings.
DATABASE_URL=
DIRECT_URL=

AUTH_SECRET=
# Required when running behind a reverse proxy (Caddy) — without this,
# NextAuth doesn't trust the forwarded host/protocol headers and login
# redirects/cookies can break.
AUTH_TRUST_HOST=true

BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Shared secret so only the external cron pinger can trigger /api/cron/*
CRON_SECRET=

# Shared secret the physical check-in kiosk device enters once at
# /checkin/setup — without this set, the roster/face-descriptor fetch and
# check-in recording are reachable by anyone who loads the public /checkin
# page, not just the one kiosk. Generate with e.g. `openssl rand -hex 32`.
KIOSK_SECRET=

GROQ_API_KEY=

# The public domain this server is reachable at — must already point here
# in DNS before starting Caddy, so it can issue a Let's Encrypt cert.
# Example: attendance.gmrgroup.com (no https://, no trailing slash)
DOMAIN=
