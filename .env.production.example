# Copy this file to .env.production on the SERVER and fill in real values.
# Never commit .env.production itself — it's gitignored (.env*).

# Same Neon / Prisma Postgres database the app already uses on Vercel — no
# data migration needed, just point at the same connection strings.
DATABASE_URL=
DIRECT_URL=

AUTH_SECRET=
# Required when running behind a reverse proxy (Caddy) — without this,
# NextAuth doesn't trust the forwarded host/protocol headers and login
# redirects/cookies can break.
AUTH_TRUST_HOST=true

BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Shared secret so only the external cron pinger can trigger /api/cron/*
CRON_SECRET=

GROQ_API_KEY=

# The public domain this server is reachable at — must already point here
# in DNS before starting Caddy, so it can issue a Let's Encrypt cert.
# Example: attendance.gmrgroup.com (no https://, no trailing slash)
DOMAIN=

# --- CloudPanel (no Docker) deployment ---
# Must equal the "App Port" on the CloudPanel site. NOT 80/443 (Nginx owns those).
PORT=3417
HOSTNAME=127.0.0.1

# --- Modbus I/O module (/modbus page) ---
# The server must be on the same network as the module — a cloud host
# (e.g. Vercel) cannot reach a private LAN address.
MODBUS_HOST=192.168.1.12
MODBUS_PORT=502
MODBUS_UNIT_ID=1
# Addresses can also be edited on the /modbus page (ADMIN/OPERATOR); those win over these.
# Second module (CH17-CH32): leave empty until it is installed, then fill in its IP.
# MODBUS_HOST_2=
# MODBUS_PORT_2=502       # defaults to module 1's
# MODBUS_UNIT_ID_2=1      # defaults to module 1's
# Auto-off for outputs someone forgot to switch off (needs the cron job in
# DEPLOY.md). Time is Bangkok time, "off" disables the daily cutoff.
MODBUS_AUTO_OFF_TIME=20:00
# Optional: also switch an output off after it has been ON this many hours.
# MODBUS_AUTO_OFF_HOURS=10
# The module forgets every output ~2 s after the last Modbus request, so the
# server keeps polling while anything is ON (keep-alive), and a background
# supervisor re-applies the saved state after a restart / network drop.
# MODBUS_KEEPALIVE_MS=500        # poll interval while something is ON (0 = off)
# MODBUS_SUPERVISE_MS=3000       # how often the supervisor checks the module
# MODBUS_AUTO_RESTORE=off        # uncomment to disable auto-restore (e.g. on a dev PC)

# --- Cloud web + Raspberry Pi agent (see agent/README.md) ---
# "direct" (default): this server talks to the module itself (must be on its LAN).
# "agent": the web app runs in the cloud; a Raspberry Pi on the module's LAN does
# the Modbus work and talks to this app via /api/modbus-agent/*.
# MODBUS_MODE=agent
# Shared secret for the Pi (long + random):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MODBUS_AGENT_TOKEN=
